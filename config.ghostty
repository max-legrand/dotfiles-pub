font-family = "Berkeley Mono"
font-family-bold = "Berkeley Mono"
font-family-italic = "Berkeley Mono"
font-family-bold-italic = "Berkeley Mono"
font-size = 15

background = 22212C
foreground = DDDDDD

# background-opacity = 0.9
background-opacity = 1

window-padding-x = 10
window-padding-y = 10


palette = 0=#000000
palette = 1=#EC8FB0
palette = 2=#00FFAA
palette = 3=#D6C5A5
palette = 4=#33AACC
palette = 5=#CDC1FF
palette = 6=#656ea4
palette = 7=#DDDDDD

palette = 8=#403833
palette = 9=#E8838F
palette = 10=#00FFAA
palette = 11=#D6C5A5
palette = 12=#5CBCD6
palette = 13=#AD99FF
palette = 14=#7E86B4
palette = 15=#A8A8A8

window-decoration = none
gtk-titlebar = false
window-show-tab-bar = never
gtk-toolbar-style = flat


command = "wsl.exe --cd ~"
env = COLORTERM=truecolor
env = WSLENV=COLORTERM
shell-integration = fish
title = " "
cursor-style-blink = false
shell-integration-features = sudo,title,no-cursor
macos-titlebar-style = hidden
cursor-style = block


font-feature = -calt, -liga, -dlig
# grapheme-width-method = legacy
keybind = shift+enter=text:\x1b\r
keybind = ctrl+semicolon=csi:59;5u
